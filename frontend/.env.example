# WalletConnect (Reown) project id. Optional: injected wallets work without it.
# Create one for free at https://cloud.reown.com
NEXT_PUBLIC_WALLET_CONNECT_ID=

# Public origin of the deployed site, used for absolute Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=

