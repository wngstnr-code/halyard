# Optional. Without it the keeper runs in watch-only mode and never sends a transaction.
# Use a fresh hot wallet funded with a little BNB for gas only.
KEEPER_PRIVATE_KEY=

# Optional RPC overrides. Defaults are public endpoints that need no key.
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# BSC_LOGS_RPC_URL=https://bsc-mainnet.nodereal.io/v1/64a9df0874fb4a93b9d0a3849de012d3

# Seconds between passes.
POLL_SECONDS=60

# Skip plans whose tip is below this many USDT.
MIN_TIP_USDT=0

# Set to 1 to simulate only, even with a key.
DRY_RUN=0

# Optional Binance Web3 API keys (https://web3.binance.com/en/dev-portal). Enables bStock market
# status, a second-opinion simulation and MEV-protected broadcast. Both are needed.
# BINANCE_WEB3_API_KEY=
# BINANCE_WEB3_SECRET_KEY=

# With the keys set, send live transactions through the Web3 API broadcast. Set to 0 to use the RPC.
# BINANCE_BROADCAST=1
